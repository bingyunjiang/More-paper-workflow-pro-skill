  "edges": [
    {"id": "m1", "source": "question", "target": "evidence"},
    {"id": "m2", "source": "evidence", "target": "model"},
    {"id": "m3", "source": "model", "target": "experiment"},
    {"id": "m4", "source": "experiment", "target": "analysis"},
    {"id": "m5", "source": "analysis", "target": "review"}
  ],
  "groups": [],
  "annotations": [
    {"id": "trace", "label": "每个结论均回指数据、模型和验证条件"}
