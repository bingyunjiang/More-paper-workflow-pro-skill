    {"id": "model", "label_runs": [{"kind": "text", "value": "模型构建 "}, {"kind": "math", "value": "y=f(x;\\theta)"}], "role": "method", "order": 3},
    {"id": "experiment", "label": "实验或仿真验证", "role": "method", "order": 4},
    {"id": "analysis", "label_runs": [{"kind": "text", "value": "误差分析 "}, {"kind": "math", "value": "\\epsilon=y-\\hat{y}"}], "role": "analysis", "order": 5},
    {"id": "review", "label": "结果审阅与边界说明", "role": "output", "order": 6}
